    "isbot": "^5.1.36",
    "lucide-react": "^1.28.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.9.6",
    "rough-notation": "^0.5.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.15.3",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@react-router/dev": "^7.9.6",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
